<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_app" android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="64dp" android:layout_height="64dp">

                    <TextView
                        android:id="@+id/tvInitials"
                        android:layout_width="64dp" android:layout_height="64dp"
                        android:background="@drawable/bg_circle" android:gravity="center"
                        android:text="?" android:textColor="#231A00"
                        android:textSize="22sp" android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/imgAvatar"
                        android:layout_width="64dp" android:layout_height="64dp"
                        android:contentDescription="Profile"
                        android:scaleType="centerCrop" android:visibility="gone" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp" android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Welcome Back!" android:textColor="#5A6B8C"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvUserName"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Student" android:textColor="#12264A"
                        android:textSize="19sp" android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Ilmora" android:textColor="#1565C0"
                    android:textSize="16sp" android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnSettings"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp" android:padding="6dp"
                    android:text="⚙" android:textColor="#12264A"
                    android:textSize="22sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_progress_card"
                    android:orientation="vertical"
                    android:paddingLeft="16dp" android:paddingRight="16dp"
                    android:paddingBottom="16dp" android:paddingTop="24dp">

                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Your Preparation Progress"
                            android:textColor="#FFFFFF" android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvProgressPct"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0%" android:textColor="#FFD54F"
                            android:textSize="16sp" android:textStyle="bold" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/pbProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent" android:layout_height="12dp"
                        android:layout_marginTop="10dp" android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/bg_progress_v2" />

                    <TextView
                        android:id="@+id/tvProgressNote"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Practice accuracy — attempt questions to grow it"
                        android:textColor="#E3E9FF" android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="52dp" android:layout_height="40dp"
                    android:layout_gravity="top|center_horizontal"
                    android:contentDescription="Crown"
                    android:src="@drawable/ic_crown" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:orientation="horizontal">

                <Button
                    android:id="@+id/btnMock"
                    android:layout_width="0dp" android:layout_height="86dp"
                    android:layout_marginRight="6dp" android:layout_weight="1"
                    android:background="@drawable/bg_tile_sunset"
                    android:drawableTop="@drawable/ic_mock"
                    android:drawablePadding="4dp"
                    android:text="Mock Test" android:textColor="#FFFFFF"
                    android:textSize="15sp" android:textStyle="bold" />

                <Button
                    android:id="@+id/btnPerformance"
                    android:visibility="gone"
                    android:layout_width="0dp" android:layout_height="86dp"
                    android:layout_marginLeft="6dp" android:layout_weight="1"
                    android:background="@drawable/bg_tile_orange"
                    android:text="📊&#10;Performance" android:textColor="#FFFFFF"
                    android:textSize="15sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:orientation="horizontal"
                android:visibility="gone">

                <Button
                    android:id="@+id/btnLeaderboard"
                    android:layout_width="0dp" android:layout_height="86dp"
                    android:layout_marginRight="6dp" android:layout_weight="1"
                    android:background="@drawable/bg_tile_teal"
                    android:text="🏆&#10;Leaderboard" android:textColor="#FFFFFF"
                    android:textSize="15sp" android:textStyle="bold" />

                <Button
                    android:id="@+id/btnProfile"
                    android:layout_width="0dp" android:layout_height="86dp"
                    android:layout_marginLeft="6dp" android:layout_weight="1"
                    android:background="@drawable/bg_tile_blue"
                    android:text="👤&#10;My Profile" android:textColor="#FFFFFF"
                    android:textSize="15sp" android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvQuote"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:gravity="center"
                android:background="@drawable/bg_quote" android:padding="16dp"
                android:fontFamily="cursive"
                android:text="“Dream Big, Prepare Better!”"
                android:textColor="#12264A" android:textSize="17sp"
                android:textStyle="bold|italic" />

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="18dp" android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnBooks"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:gravity="center"
                    android:orientation="vertical" android:clickable="true">

                    <FrameLayout
                        android:layout_width="86dp" android:layout_height="86dp">

                        <View
                            android:layout_width="86dp" android:layout_height="86dp"
                            android:background="@drawable/bg_circle_books" />

                        <View
                            android:layout_width="68dp" android:layout_height="68dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_circle_white" />

                        <ImageView
                            android:layout_width="40dp" android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:contentDescription="Books Library"
                            android:src="@drawable/ic_books" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:gravity="center"
                        android:text="Books Library" android:textColor="#12264A"
                        android:textSize="13sp" android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Class 9-12 • Free PDFs" android:textColor="#5A6B8C"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnPapers"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:gravity="center"
                    android:orientation="vertical" android:clickable="true">

                    <FrameLayout
                        android:layout_width="86dp" android:layout_height="86dp">

                        <View
                            android:layout_width="86dp" android:layout_height="86dp"
                            android:background="@drawable/bg_circle_ecat" />

                        <View
                            android:layout_width="68dp" android:layout_height="68dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_circle_white" />

                        <ImageView
                            android:layout_width="40dp" android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:contentDescription="ECAT Past Papers"
                            android:src="@drawable/ic_papers" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:gravity="center"
                        android:text="ECAT Past Papers" android:textColor="#12264A"
                        android:textSize="13sp" android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="UET Papers • Free PDFs" android:textColor="#5A6B8C"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnAssistant"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:gravity="center"
                    android:orientation="vertical" android:clickable="true">

                    <FrameLayout
                        android:layout_width="86dp" android:layout_height="86dp">

                        <View
                            android:layout_width="86dp" android:layout_height="86dp"
                            android:background="@drawable/bg_circle_ai" />

                        <View
                            android:layout_width="68dp" android:layout_height="68dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_circle_white" />

                        <ImageView
                            android:layout_width="40dp" android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:contentDescription="AI Study Assistant"
                            android:src="@drawable/ic_assistant" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:gravity="center"
                        android:text="AI Assistant" android:textColor="#12264A"
                        android:textSize="13sp" android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Ask Anything" android:textColor="#5A6B8C"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Sections" android:textColor="#12264A"
                android:textSize="18sp" android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Choose your section and start preparing"
                android:textColor="#5A6B8C" android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/layoutSubjects"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:orientation="vertical" />

            <Button
                android:id="@+id/btnManage"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_btn_primary"
                android:text="⚙️  Manage MCQs (Admin)"
                android:textColor="#FFFFFF" android:textSize="15sp"
                android:textStyle="bold" android:visibility="gone" />

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:layout_marginTop="12dp" android:layout_marginBottom="6dp"
                android:background="@drawable/bg_btn_ghost"
                android:text="Logout" android:textColor="#1565C0"
                android:textSize="15sp" android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_nav" android:orientation="horizontal"
        android:paddingTop="8dp" android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center"
            android:drawableTop="@drawable/ic_home"
            android:drawableTint="#1565C0" android:drawablePadding="2dp"
            android:text="Home" android:textColor="#1565C0"
            android:textSize="12sp" android:textStyle="bold" />

        <TextView
            android:id="@+id/navPerformance"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center"
            android:drawableTop="@drawable/ic_chart"
            android:drawableTint="#7C3AED" android:drawablePadding="2dp"
            android:text="Analytics" android:textColor="#7C3AED"
            android:textSize="12sp" android:textStyle="bold" />

        <TextView
            android:id="@+id/navProfile"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center"
            android:drawableTop="@drawable/ic_profile"
            android:drawableTint="#059669" android:drawablePadding="2dp"
            android:text="Profile" android:textColor="#059669"
            android:textSize="12sp" android:textStyle="bold" />

        <TextView
            android:id="@+id/navLeaderboard"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center"
            android:drawableTop="@drawable/ic_trophy"
            android:drawableTint="#D97706" android:drawablePadding="2dp"
            android:text="Ranks" android:textColor="#D97706"
            android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>
<FrameLayout
        android:id="@+id/adContainer"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" />

    <TextView
        android:id="@+id/tvAdStatus"
        android:visibility="gone"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:padding="3dp"
        android:text="Ad status: ..." android:textColor="#5A6B8C"
        android:textSize="12sp" />
</LinearLayout>
