            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-5229747293404900~9451816666" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
