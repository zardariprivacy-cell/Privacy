<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_app" android:gravity="center"
    android:orientation="vertical" android:padding="32dp">

    <TextView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:text="🔐 Guftagu Band Hai"
        android:textColor="@color/ink" android:textSize="24sp" android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:gravity="center"
        android:text="Apna PIN daalo" android:textColor="@color/sub" android:textSize="15sp" />

    <EditText
        android:id="@+id/etPin"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="28dp" android:background="@drawable/bg_input"
        android:gravity="center" android:hint="PIN" android:inputType="numberPassword"
        android:padding="16dp" android:textColor="@color/ink"
        android:textColorHint="@color/sub" android:textSize="20sp" />

    <Button
        android:id="@+id/btnUnlock"
        android:layout_width="match_parent" android:layout_height="54dp"
        android:layout_marginTop="16dp" android:background="@drawable/bg_btn_teal"
        android:text="Kholo" android:textColor="#FFFFFF"
        android:textSize="16sp" android:textStyle="bold" />

    <TextView
        android:id="@+id/tvForgot"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="22dp" android:gravity="center"
        android:text="PIN bhool gaye? Logout karke dobara login karo"
        android:textColor="#00A884" android:textSize="14sp" />
</LinearLayout>
