<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_app" android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/bg_header" android:gravity="center_vertical"
        android:orientation="horizontal" android:padding="8dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content" android:layout_height="44dp"
            android:background="@drawable/bg_btn_ghost" android:paddingLeft="13dp"
            android:paddingRight="13dp" android:text="←"
            android:textColor="#111111" android:textSize="17sp" />

        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginLeft="10dp" android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvChatTitle"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Sab ka Group" android:textColor="#111111"
                android:textSize="17sp" android:textStyle="bold" />
            <TextView
                android:id="@+id/tvChatSub"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🔒 end-to-end encrypted" android:textColor="#667781"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSafety"
            android:layout_width="wrap_content" android:layout_height="44dp"
            android:background="@drawable/bg_btn_ghost" android:paddingLeft="13dp"
            android:paddingRight="13dp" android:text="🔑"
            android:textColor="#111111" android:textSize="15sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/wallpaperRoot"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/chatScroll"
            android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout
                android:id="@+id/msgList"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="10dp" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="bottom" android:orientation="vertical"
            android:paddingLeft="8dp" android:paddingRight="8dp" android:paddingBottom="8dp">

            <LinearLayout
                android:id="@+id/recordBar"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="6dp" android:background="@drawable/bg_pill"
                android:gravity="center_vertical" android:orientation="horizontal"
                android:padding="8dp" android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="●" android:textColor="#F44336" android:textSize="16sp" />
                <TextView
                    android:id="@+id/tvRecTime"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp" android:layout_weight="1"
                    android:text="0:00" android:textColor="#111111" android:textSize="16sp" />
                <Button
                    android:id="@+id/btnRecCancel"
                    android:layout_width="wrap_content" android:layout_height="42dp"
                    android:background="@drawable/bg_btn_ghost" android:paddingLeft="14dp"
                    android:paddingRight="14dp" android:text="Cancel"
                    android:textColor="#111111" android:textSize="14sp" />
                <Button
                    android:id="@+id/btnRecSend"
                    android:layout_width="wrap_content" android:layout_height="42dp"
                    android:layout_marginLeft="8dp" android:background="@drawable/bg_btn_teal"
                    android:paddingLeft="16dp" android:paddingRight="16dp" android:text="Bhejo ➤"
                    android:textColor="#FFFFFF" android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/inputBar"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="bottom" android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:background="@drawable/bg_pill"
                    android:gravity="center_vertical" android:orientation="horizontal"
                    android:paddingLeft="2dp" android:paddingRight="4dp">
                    <TextView
                        android:id="@+id/btnEmoji"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:padding="9dp" android:text="😊" android:textSize="22sp" />
                    <EditText
                        android:id="@+id/etMessage"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:background="@null"
                        android:hint="Message" android:inputType="textMultiLine"
                        android:maxLines="4" android:paddingTop="11dp"
                        android:paddingBottom="11dp" android:textColor="#111111"
                        android:textColorHint="#667781" android:textSize="16sp" />
                    <TextView
                        android:id="@+id/btnAttach"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:padding="8dp" android:text="📎" android:textSize="21sp" />
                    <TextView
                        android:id="@+id/btnCamera"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:padding="8dp" android:text="📷" android:textSize="21sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnMicSend"
                    android:layout_width="52dp" android:layout_height="52dp"
                    android:layout_marginLeft="8dp" android:background="@drawable/bg_btn_circle"
                    android:text="🎤" android:textColor="#FFFFFF" android:textSize="21sp" />
            </LinearLayout>

            <GridLayout
                android:id="@+id/emojiPanel"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:background="@drawable/bg_pill"
                android:columnCount="8" android:padding="8dp" android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
